# Managed by asus-healthytable-linux
# SPDX-License-Identifier: GPL-2.0-only
# D-Bus activated only (no [Install] section): the activation file names this
# unit; nothing enables or starts it at boot.
[Unit]
Description=Zenbook hardware privileged service (polkit-mediated)
# Abuse cannot disable activation permanently: at most 10 starts per 5 min,
# after which activation works again once the interval has passed.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=dbus
BusName=org.zenbook.Hardware1
ExecStart=/usr/bin/python3 -I -B @RUNTIME@/service/zenbook_hardwared.py
# Restores firmware-automatic fan control if a lease marker remains (crash,
# kill or stop while a lease was active). No-op otherwise.
ExecStopPost=/usr/bin/python3 -I -B @RUNTIME@/service/zenbook_hardwared.py --restore-fan-auto
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
TimeoutStopSec=10
WorkingDirectory=/
Environment=PATH=/usr/sbin:/usr/bin LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1
Environment=ZENBOOK_HWMON_CONTAINER=@HWMON@
User=root
# uid 0 is used only for DAC ownership of root-owned sysfs nodes (0200/0400/
# 0644) and /dev/usbmon0 (0600); the driver performs no capable() checks.
# The bounding set removes CAP_DAC_OVERRIDE, CAP_SYS_ADMIN, CAP_SYS_MODULE,
# CAP_SYS_RAWIO, CAP_LINUX_IMMUTABLE and every other capability. Signalling
# other uid-0 processes needs no CAP_KILL, so PrivatePIDs= hides them.
# Single exception: CAP_PERFMON, because perf_event_paranoid on this system
# requires it to open the system-wide i915 engine PMU for WMIGetGPUUsg (read
# only counters). uid 0 under SecureBits=noroot needs it as an ambient
# capability to have it in the effective set.
CapabilityBoundingSet=CAP_PERFMON
AmbientCapabilities=CAP_PERFMON
SecureBits=noroot-locked
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
PrivatePIDs=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# /sys and /proc/sys become read-only; writable are the driver's hwmon
# container (index-independent; holds only the hwmonN instance) and the exact
# canonical attribute files below, generated by the installer.
ProtectKernelTunables=yes
@READ_WRITE_PATHS@
InaccessiblePaths=-/sys/kernel/tracing -/sys/kernel/debug/tracing -/sys/fs/bpf
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=all
DevicePolicy=closed
DeviceAllow=/dev/usbmon0 r
@TABLET_DEVICES@
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=perf_event_open
SystemCallFilter=~@privileged @resources @mount @module @raw-io @reboot @swap @cpu-emulation @obsolete
# @debug minus perf_event_open (needed for the i915 PMU): a group deny would
# override the explicit allow above, so its other members are denied by name
# (systemd 259 `systemd-analyze syscall-filter @debug`).
SystemCallFilter=~lookup_dcookie pidfd_getfd ptrace rtas s390_runtime_instr sys_debug_setcontext
SystemCallErrorNumber=EPERM
# Shared with the root CLI's flock files; also holds the fan-lease marker that
# ExecStopPost and the next start use for restoration, so it is preserved.
RuntimeDirectory=zenbook-hardware
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
KeyringMode=private
TasksMax=16
MemoryMax=256M
LimitNOFILE=256
